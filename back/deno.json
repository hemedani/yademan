{
  "tasks": {
    "bc-dev": "ENV=development deno run -A --watch --watch-exclude=declarations --no-clear-screen ./mod.ts",
    "test:bootstrap": "deno run -A test/bootstrap.ts",
    "test:build": "deno run -A test/build-suites.ts",
    "test:e2e": "deno run -A test/run-e2e.ts --file test/E2E.json --with-upload",
    "test:seed": "deno run -A test/run-e2e.ts --file test/seed-presentation.json"
  },
  "fmt": {
    "files": {
      "exclude": [
        "declaration"
      ]
    },
    "options": {
      "useTabs": true,
      "lineWidth": 80,
      "indentWidth": 4,
      "semiColons": true,
      "proseWrap": "preserve"
    }
  },
  "imports": {
    "@da/bcrypt": "jsr:@da/bcrypt@^1.0.1",
    "@deps": "./deps.ts",
    "@lib": "./utils/mod.ts",
    "@model": "./models/mod.ts",
  },
  "nodeModulesDir": "auto"
}
